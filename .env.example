# HR Documents Library — Supabase read path (public.doclib_* views, RLS read-only).
# The anon key is publishable by design, but PostgREST exposes the entire
# `public` schema it's granted on — not just the doclib_* demo views — so
# treat it as a project-wide credential, not a scoped one. Without these vars
# the app serves the identical bundled fixtures.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# SEO / prerendering (all optional — see docs/SEO_GEO_IMPLEMENTATION.md).
# VITE_SITE_ORIGIN overrides the canonical origin baked into every canonical
# URL, hreflang link, sitemap entry, and JSON-LD @id at build time. Leave it
# unset in production: the default is https://dutiva.ca (src/seo/site.ts).
# VITE_SITE_ORIGIN=https://dutiva.ca
#
# Search-engine ownership verification (public tokens, not secrets — but keep
# them out of the repo so each deployment declares its own). When set at
# build time, scripts/prerender.mjs injects the corresponding meta tag into
# every prerendered page.
# GOOGLE_SITE_VERIFICATION=...   # <meta name="google-site-verification">
# BING_SITE_VERIFICATION=...     # <meta name="msvalidate.01">

# Stripe billing (Pricing page checkout + billing portal + webhook, all under
# supabase/functions/). Server-side secrets only — never prefix these with
# VITE_ or they'd be bundled into the public client. Without them the
# create-checkout-session / create-portal-session / stripe-webhook functions
# respond 503 "not configured" rather than failing hard; an @dutiva.ca
# account still bypasses the paywall with none of this set (see
# src/lib/billing/adminAccess.ts).
# SITE_URL=https://www.dutiva.ca                 # used to build Stripe success/cancel/return URLs
# STRIPE_SECRET_KEY=sk_live_...                  # Stripe secret key
# STRIPE_WEBHOOK_SECRET=whsec_...                # Stripe webhook signing secret (stripe-webhook function)
# STRIPE_PRICE_STARTER_MONTHLY=price_...         # Starter plan monthly price ID
# STRIPE_PRICE_GROWTH_MONTHLY=price_...          # Growth plan monthly price ID
# STRIPE_PRICE_PRO_MONTHLY=price_...             # Professional plan monthly price ID
